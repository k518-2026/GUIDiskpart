<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">
    
    <s:String x:Key="AppTitle">GUIDiskpart Studio</s:String>
    <s:String x:Key="BtnRefresh">🔄 ディスク情報を再認識 (USB対応)</s:String>
    <s:String x:Key="GrpDiskOperation"> ディスク全体への操作 </s:String>
    <s:String x:Key="BtnClean">1. Clean (全消去・初期化)</s:String>
    <s:String x:Key="BtnPartition">2. 最大パーティション作成</s:String>
    <s:String x:Key="BtnEject">⏏️ 安全に取り外す (イジェクト)</s:String>
    <s:String x:Key="GrpPartOperation"> 選択パーティションへの操作 </s:String>
    <s:String x:Key="BtnFormat">3. フォーマット (NTFS)</s:String>
    <s:String x:Key="BtnAssign">4. ドライブレター自動割当</s:String>
    <s:String x:Key="BtnDeletePart">5. パーティション削除</s:String>
    <s:String x:Key="StatusWaiting">待機中...</s:String>
    <s:String x:Key="SelectedNone">選択項目: なし (ツリーから選択してください)</s:String>
    <s:String x:Key="TreePartition" xml:space="preserve">└ パーティション </s:String>
    <s:String x:Key="LangButton">English</s:String>
</ResourceDictionary>